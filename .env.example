# Copiado a .env por `make up`. Valores seguros solo para desarrollo.
HUBFLOW_HTTP_PORT=8480
HUBFLOW_DB_PORT=3317
DB_NAME=hubflow
DB_USER=hubflow
DB_PASSWORD=hubflow-dev-pass
DB_ROOT_PASSWORD=hubflow-root-dev
# `make up` reemplaza este valor por uno aleatorio de 48 caracteres al crear .env
HUBFLOW_JWT_SECRET=change-me-change-me-change-me-change-me-0000
HUBFLOW_SEED_PASSWORD=hubflow123
# Código de seguimiento de los envíos nuevos: public (HF-XXXXXXXXX, no adivinable) o sequential (PKG-NNNN)
HUBFLOW_TRACKING_CODES=public
# Dirección pública del sitio: va en las etiquetas de los bultos y en los avisos a clientes (enlace de seguimiento)
HUBFLOW_PUBLIC_BASE_URL=http://localhost:8480
